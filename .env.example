# Flask
SECRET_KEY=change_this_to_a_long_random_secret
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
SESSION_LIFETIME_DAYS=30
REMEMBER_COOKIE_DAYS=30
LOG_LEVEL=INFO

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agroguide
DB_USER=postgres
DB_PASSWORD=your_password
AUTO_INIT_DB=false

# Uploads
MAX_UPLOAD_MB=8

# Admin seed values used only when AUTO_INIT_DB=true
ADMIN_EMAIL=admin@agroguide.com
ADMIN_PASSWORD=Admin@12345

# AI disease scanner (AWS EC2 Flask API)
MODEL_API_URL=http://your-ec2-public-host-or-ip:5000/predict
MODEL_API_TIMEOUT_SECONDS=30

# Gemini chatbot fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Internet search for RAG chatbot
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Optional: production profile
#FLASK_CONFIG=production
#FLASK_DEBUG=false
