# Flask
SECRET_KEY=change_this_to_a_long_random_secret
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
SESSION_LIFETIME_DAYS=30
REMEMBER_COOKIE_DAYS=30
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agroguide
DB_USER=postgres
DB_PASSWORD=your_password
AUTO_INIT_DB=false

# Uploads
MAX_UPLOAD_MB=8

# Admin seed values used only when AUTO_INIT_DB=true
ADMIN_EMAIL=admin@agroguide.com
ADMIN_PASSWORD=Admin@12345

# AI disease scanner (AWS EC2 Flask API)
MODEL_API_URL=http://your-ec2-public-host-or-ip:5000/predict
MODEL_API_TIMEOUT_SECONDS=30

# Gemini chatbot fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Internet search for RAG chatbot
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Email delivery
# Use NODEMAILER_ENDPOINT for an existing Nodemailer HTTP mail service.
NODEMAILER_ENDPOINT=
NODEMAILER_API_KEY=
MAIL_FROM=AgroGuide <no-reply@agroguide.local>
# Optional SMTP fallback when NODEMAILER_ENDPOINT is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=15

# Disease outbreak alerts
OUTBREAK_ALERT_THRESHOLD=3
OUTBREAK_ALERT_RADIUS_KM=25
OUTBREAK_ALERT_WINDOW_HOURS=72

# Optional: production profile
#FLASK_CONFIG=production
#FLASK_DEBUG=false
